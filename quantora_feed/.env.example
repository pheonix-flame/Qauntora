# Copy to .env (same folder) and fill in. .env is gitignored — never commit it.

# --- MT5 (Deriv) -----------------------------------------------------------
# Not an API key: your MT5 account number, its password, and the server name
# shown when you created the MT5 account in Deriv's Trader's Hub.
MT5_LOGIN=12345678
MT5_PASSWORD=
MT5_SERVER=Deriv-Demo
# Optional: full path to terminal64.exe if you have several MT5 installs.
MT5_TERMINAL_PATH=

# Broker clock. Leave both empty to auto-detect from a live V75 tick
# (`python main.py check` prints what it found). If the server observes DST,
# set an IANA zone instead so historical bars convert correctly.
BROKER_TZ=
BROKER_UTC_OFFSET_HOURS=

# --- Symbols -----------------------------------------------------------------
# Empty = all: V75,V100,STEP,EURUSD,GBPUSD,USDJPY,AUDUSD,XAUUSD,BTCUSD,ETHUSD
QTX_SYMBOLS=
# Override a broker-side name if `check` says NOT FOUND, e.g.:
# QTX_BROKER_NAME_V75=Volatility 75 (1s) Index

BACKFILL_DAYS=365

# --- Oracle -------------------------------------------------------------------
# Local Oracle AI Database Free: host:port/service. FREEPDB1 is the default
# pluggable database the Free installer creates.
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=quantora
ORACLE_PASSWORD=
# Only for Oracle Cloud Autonomous Database with mutual TLS: the unzipped wallet
# folder and its password. Leave empty for a local database.
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# --- Economic calendar --------------------------------------------------------
# forexfactory = free weekly feed, no key needed (default)
# fmp          = Financial Modeling Prep, needs FMP_API_KEY
# none         = disabled
NEWS_PROVIDER=forexfactory
FMP_API_KEY=
NEWS_REFRESH_HOURS=6
