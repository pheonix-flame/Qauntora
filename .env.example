# =============================================================================
#  QUANTORA — the ONE settings file for every engine.
#
#  1. Copy this file to  Qauntora/.env   (same folder as this file)
#  2. Fill in the values marked  >>> REQUIRED
#  3. Never commit .env — it's in .gitignore.
#
#  Put comments on their OWN line — never after a value on the same line.
#
#  (Advanced: an engine folder may also have its own .env, e.g.
#   quantora_feed/.env; values there win over this file.)
# =============================================================================


# -----------------------------------------------------------------------------
#  MT5 / DERIV  — used by: quantora_feed (later also Sentinel)
#  Not an API key. Where to get these:
#    deriv.com → log in → Trader's Hub → switch to "Demo" → MT5 → "Get" / "Add"
#    Deriv shows the login NUMBER, the SERVER name and lets you set the PASSWORD.
#    Forgot them? Trader's Hub → your MT5 account → "Details" / "Change password".
# -----------------------------------------------------------------------------
# >>> REQUIRED  your MT5 account number
MT5_LOGIN=12345678
# >>> REQUIRED  your MT5 account password (not your Deriv login password)
MT5_PASSWORD=
# >>> REQUIRED  exactly as Deriv shows it, e.g. Deriv-Demo
MT5_SERVER=Deriv-Demo
# optional: full path to terminal64.exe if you have several MT5 installs
MT5_TERMINAL_PATH=

# Broker clock. Leave BOTH empty: Feed measures it from a live tick, and
# `python main.py verify` double-checks it. Only set if verify tells you to.
BROKER_TZ=
BROKER_UTC_OFFSET_HOURS=


# -----------------------------------------------------------------------------
#  ORACLE DATABASE  — used by: quantora_feed (writes), quantora_backtest (reads)
#  You choose this password yourself when you create the database user:
#      sqlplus sys@localhost:1521/FREEPDB1 as sysdba
#      CREATE USER quantora IDENTIFIED BY "your-password" ...   (full steps in README.md)
#  The SYS password you picked while installing Oracle is NOT this one.
# -----------------------------------------------------------------------------
ORACLE_USER=quantora
# >>> REQUIRED  the password from CREATE USER above
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1
# Only for Oracle Cloud Autonomous Database (leave empty for a local install):
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=


# -----------------------------------------------------------------------------
#  ECONOMIC CALENDAR  — used by: quantora_feed
#  Default needs NO key. Only fill FMP_API_KEY if you switch to "fmp":
#    financialmodelingprep.com → Sign up → Dashboard → copy "API Key"
#    (check your plan includes the economic calendar).
# -----------------------------------------------------------------------------
# forexfactory (free, no key) | fmp | none
NEWS_PROVIDER=forexfactory
FMP_API_KEY=
NEWS_REFRESH_HOURS=6


# -----------------------------------------------------------------------------
#  FEED OPTIONS  — used by: quantora_feed
# -----------------------------------------------------------------------------
# Empty = all 10: V75,V100,STEP,EURUSD,GBPUSD,USDJPY,AUDUSD,XAUUSD,BTCUSD,ETHUSD
QTX_SYMBOLS=
# If `check` says a symbol is NOT FOUND, set its exact MT5 name, e.g.:
# QTX_BROKER_NAME_V75=Volatility 75 (1s) Index
BACKFILL_DAYS=365


# -----------------------------------------------------------------------------
#  TELEGRAM  — used by: quantora_notify
#  Step-by-step: README.md -> "Create your Telegram bot". In short:
#    1. In Telegram, open @BotFather (blue tick) -> /newbot -> pick a name and a
#       username ending in "bot" -> BotFather replies with the token below.
#    2. Open your new bot's chat, press START, send it "hi".
#    3. In quantora_notify run:  python main.py chat-id   -> paste the id below.
#    4. python main.py test  -> you should get a message on your phone.
#  The token is a password: anyone who has it can send messages as your bot.
#  If it ever leaks: @BotFather -> /revoke -> paste the new token here.
# -----------------------------------------------------------------------------
# >>> REQUIRED for Notify, e.g. 7234567890:AAH...
TELEGRAM_BOT_TOKEN=
# >>> REQUIRED for Notify, from `python main.py chat-id`
TELEGRAM_CHAT_ID=
